
<?xml version="1.0"?>
<robot name="weed_removal_droid">

  <!-- Main chassis -->
  <link name="base_link">
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.12" ixy="0" ixz="0"
               iyy="0.18" iyz="0" izz="0.25"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.50 0.38 0.14"/>
      </geometry>
      <material name="forest_green">
        <color rgba="0.08 0.35 0.16 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.50 0.38 0.14"/>
      </geometry>
    </collision>
  </link>

  <!-- Front-left wheel -->
  <link name="left_front_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="rubber">
        <color rgba="0.12 0.12 0.12 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.16 0.22 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front-right wheel -->
  <link name="right_front_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.16 -0.22 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear-left wheel -->
  <link name="left_rear_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.16 0.22 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear-right wheel -->
  <link name="right_rear_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.16 -0.22 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Camera mast -->
  <link name="camera_mast">
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry>
        <box size="0.035 0.035 0.20"/>
      </geometry>
      <material name="metal">
        <color rgba="0.65 0.67 0.68 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mast"/>
    <origin xyz="0.13 0 0.04"/>
  </joint>

  <!-- Camera housing at the front -->
  <link name="camera_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.09 0.08 0.06"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.18 0.20 0.22 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_mast"/>
    <child link="camera_link"/>
    <origin xyz="0.07 0 0.20"/>
  </joint>

  <!-- Front tool support -->
  <link name="weeding_tool_mount">
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.08"/>
      </geometry>
      <material name="tool_metal">
        <color rgba="0.55 0.57 0.58 1"/>
      </material>
    </visual>
  </link>

  <joint name="weeding_tool_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="weeding_tool_mount"/>
    <origin xyz="0.24 0 -0.035"/>
  </joint>

  <!-- Mechanical weeding blade -->
  <link name="weeding_blade">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.20 0.035 0.025"/>
      </geometry>
      <material name="blade_material">
        <color rgba="0.72 0.74 0.76 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.20 0.035 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="weeding_blade_joint" type="fixed">
    <parent link="weeding_tool_mount"/>
    <child link="weeding_blade"/>
    <origin xyz="0.10 0 -0.035"/>
  </joint>

</robot>
